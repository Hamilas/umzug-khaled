---
// Layout für Rechtsseiten (Impressum): schmale Spalte mit weißen Karten je Abschnitt.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}
const { title, description, heading } = Astro.props;
---

<Base title={title} description={description}>
  <Header variant="sub" />
  <main id="inhalt" class="legal">
    <div class="head">
      <span class="eyebrow">Rechtliches</span>
      <h1>{heading}</h1>
    </div>
    <slot />
  </main>
  <Footer variant="sub" />
</Base>

<style>
  .legal {
    max-width: 820px;
    margin: 0 auto;
    padding: 56px 16px 80px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h1 {
    font-size: clamp(32px, 7vw, 44px);
    line-height: 1.1;
    font-weight: 800;
  }
  .legal :global(section) {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .legal :global(h2) {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 2px;
  }
  .legal :global(h3) {
    font-size: 16px;
    font-weight: 700;
    margin-top: 6px;
  }
  .legal :global(p),
  .legal :global(li) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
  }
  .legal :global(ul) {
    margin: 0;
    padding-left: 20px;
  }
  .legal :global(section a) {
    color: var(--navy);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    .legal {
      padding: 72px 24px 96px;
      gap: 32px;
    }
    .legal :global(section) {
      padding: 28px;
    }
  }
</style>
