---
// Grundgerüst jeder Seite: <head> mit Titel, Beschreibung, Canonical, Open-Graph-Tags
// und optionalem JSON-LD. Lädt die selbst gehostete Schrift und die globalen Styles.
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import heroImg from '../../assets/photos/hero-truck.jpg';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Vorschaubild für Social Media (1200×630) aus dem Hero-Foto erzeugen
const ogImage = await getImage({ src: heroImg, width: 1200, height: 630, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0F1F3D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph: Vorschau beim Teilen in WhatsApp, Facebook usw. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DAYFA Transporter Lieferwagen mit zwei Mitarbeitern" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Strukturierte Daten (nur wenn die Seite welche übergibt) -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <!-- Tastatur-Nutzer können direkt zum Inhalt springen -->
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <slot />
  </body>
</html>
