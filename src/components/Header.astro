---
import Logo from './Logo.astro';

interface Props {
  variant?: 'home' | 'sub';
}
const { variant = 'home' } = Astro.props;

const links = [
  { href: '/#leistungen', label: 'Leistungen' },
  { href: '/#ablauf', label: 'Ablauf' },
  { href: '/#ueber-uns', label: 'Über uns' },
  { href: '/#referenzen', label: 'Referenzen' },
  { href: '/#kontakt', label: 'Kontakt' },
];
---

<header class="site-header on-navy">
  <div class="container bar">
    <Logo />
    {
      variant === 'home' ? (
        <>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hauptnavigation">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path class="l1" d="M4 7h16" />
              <path class="l2" d="M4 12h16" />
              <path class="l3" d="M4 17h16" />
            </svg>
            <span class="sr-only">Menü öffnen</span>
          </button>
          <nav id="hauptnavigation" class="nav" aria-label="Hauptnavigation">
            <ul>
              {links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <a href="/#kontakt" class="btn btn-primary header-cta">
            Angebot anfordern
          </a>
        </>
      ) : (
        <a href="/" class="btn btn-ghost-light back">
          ← Zurück zur Startseite
        </a>
      )
    }
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('hauptnavigation');
  if (toggle && nav) {
    const label = toggle.querySelector('.sr-only')!;
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
      label.textContent = open ? 'Menü schließen' : 'Menü öffnen';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    background: var(--navy);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .nav {
    display: none;
    flex-basis: 100%;
  }
  .nav.open {
    display: block;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 8px 0 4px;
    display: flex;
    flex-direction: column;
  }
  .nav a {
    display: block;
    padding: 12px 4px;
    font-size: 16px;
    font-weight: 600;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .nav a:hover {
    color: var(--orange);
  }
  .header-cta {
    display: none;
    font-size: 14px;
    padding: 12px 22px;
  }
  .back {
    font-size: 14px;
    padding: 10px 18px;
  }

  @media (min-width: 900px) {
    .menu-toggle {
      display: none;
    }
    .nav,
    .nav.open {
      display: block;
      flex-basis: auto;
    }
    .nav ul {
      flex-direction: row;
      gap: 28px;
      padding: 0;
    }
    .nav a {
      border: 0;
      padding: 8px 0;
      font-size: 14px;
    }
    .header-cta {
      display: inline-flex;
    }
  }
</style>
