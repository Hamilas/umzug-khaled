---
const steps = [
  { title: 'Anfrage', text: 'Sie schildern uns Ihr Vorhaben – per Telefon, WhatsApp oder E-Mail.' },
  { title: 'Besichtigung', text: 'Auf Wunsch sehen wir uns alles vor Ort an und planen den Einsatz.' },
  { title: 'Angebot', text: 'Sie erhalten ein transparentes, kostenloses Angebot ohne versteckte Kosten.' },
  { title: 'Durchführung', text: 'Wir erledigen den Auftrag zum vereinbarten Termin – zuverlässig und sauber.' },
];
---

<section id="ablauf" class="ablauf on-navy" aria-labelledby="ablauf-titel">
  <div class="container inner">
    <span class="eyebrow">So funktioniert's</span>
    <h2 id="ablauf-titel" class="h2">In vier Schritten zum erledigten Auftrag.</h2>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>
              <span class="sr-only">Schritt {i + 1}: </span>
              {s.title}
            </h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ablauf {
    background: var(--navy);
    color: #fff;
  }
  .inner {
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .h2 {
    margin: 12px 0 36px;
    max-width: 560px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 32px;
  }
  li {
    border-top: 3px solid var(--orange);
    padding-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .num {
    font-size: 32px;
    font-weight: 800;
    color: var(--orange);
    line-height: 1.2;
  }
  h3 {
    font-size: 18px;
    font-weight: 700;
  }
  p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--on-navy);
  }
  @media (min-width: 768px) {
    .inner {
      padding-top: 80px;
      padding-bottom: 80px;
    }
    .h2 {
      margin-bottom: 44px;
    }
  }
</style>
