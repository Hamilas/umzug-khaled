---
import { site } from '../data/site';
---

<section id="kontakt" class="container kontakt" aria-labelledby="kontakt-titel">
  <div class="info">
    <span class="eyebrow">Kontakt</span>
    <h2 id="kontakt-titel" class="h2">Kostenloses Angebot anfragen.</h2>
    <p class="intro">
      Schildern Sie uns kurz Ihr Vorhaben – wir melden uns schnellstmöglich mit einem unverbindlichen Angebot.
    </p>
    <a href={site.whatsapp} class="row row-dark" target="_blank" rel="noopener">
      <span>WhatsApp: {site.phoneDisplay}</span><span aria-hidden="true">→</span>
    </a>
    <a href={site.phoneHref} class="row on-light">Telefon: {site.phoneDisplay}</a>
    <a href={`mailto:${site.email}`} class="row on-light email">E-Mail: {site.email}</a>
    <div class="hours">
      <strong>Erreichbarkeit</strong><br />
      <span class="placeholder">{site.openingHours}</span>
    </div>
  </div>

  <div class="location">
    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#0F1F3D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 21s7-6.2 7-11.5A7 7 0 005 9.5C5 14.8 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </svg>
    <strong>Bonn</strong>
    <address>
      {site.street}, {site.zip} {site.city} · Einsatz auch in der Umgebung und deutschlandweit auf Anfrage.
    </address>
    <a href={site.routeUrl} class="btn btn-outline on-light" target="_blank" rel="noopener">
      Route planen<span class="sr-only"> (öffnet Google Maps)</span>
    </a>
  </div>
</section>

<style>
  .kontakt {
    padding-top: 16px;
    padding-bottom: 64px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: stretch;
  }
  .info {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .intro {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    padding: 14px 20px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    background: #fff;
    border: 1px solid var(--border-strong);
  }
  .row:hover {
    border-color: var(--navy);
  }
  .row-dark {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
    font-weight: 700;
  }
  .row-dark:hover {
    background: var(--navy-mid);
  }
  .email {
    overflow-wrap: anywhere;
  }
  .hours {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }
  .hours strong {
    color: var(--navy);
  }
  .location {
    flex: 1 1 360px;
    min-width: 0;
    background: var(--bg-soft);
    border-radius: 20px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
  }
  .location strong {
    font-size: 18px;
  }
  address {
    font-style: normal;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
  .location .btn {
    margin-top: 6px;
  }
  @media (min-width: 768px) {
    .kontakt {
      padding-bottom: 88px;
    }
    .location {
      padding: 36px;
    }
  }
</style>
