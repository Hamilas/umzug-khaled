---
// Text-Logo bis eine Logodatei vorliegt (siehe TODO.md)
interface Props {
  href?: string;
}
const { href = '/' } = Astro.props;
---

<a href={href} class="logo" aria-label="DAYFA Transporter – Startseite">
  <span class="logo-main">DAYFA</span>
  <span class="logo-sub">TRANSPORTER</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    color: #fff;
    line-height: 1;
  }
  .logo-main {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .logo-sub {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--orange);
    margin-top: 4px;
  }
</style>
