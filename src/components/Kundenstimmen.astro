---
import { site } from '../data/site';

// TODO: Nur echte Kundenbewertungen (mit Einverständnis) eintragen. Keine erfundenen Texte.
const reviews = [
  { text: '[PLATZHALTER: ECHTE KUNDENBEWERTUNG HIER EINFÜGEN]', author: '[Name, Ort]' },
  { text: '[PLATZHALTER: ECHTE KUNDENBEWERTUNG HIER EINFÜGEN]', author: '[Name, Ort]' },
  { text: '[PLATZHALTER: ECHTE KUNDENBEWERTUNG HIER EINFÜGEN]', author: '[Name, Ort]' },
];
---

<section class="container section" aria-labelledby="stimmen-titel">
  <span class="eyebrow">Kundenstimmen</span>
  <h2 id="stimmen-titel">Was unsere Kunden sagen.</h2>
  <ul class="grid">
    {
      reviews.map((r) => (
        <li class="card">
          <span class="quote" aria-hidden="true">“</span>
          <blockquote>
            <p class="placeholder">{r.text}</p>
          </blockquote>
          <strong>{r.author}</strong>
        </li>
      ))
    }
  </ul>
  {
    site.googleReviewsUrl ? (
      <a href={site.googleReviewsUrl} class="btn btn-outline" target="_blank" rel="noopener">
        Bewertungen auf Google ansehen
      </a>
    ) : (
      <p class="placeholder">[PLATZHALTER: Link „Bewertungen auf Google ansehen“]</p>
    )
  }
</section>

<style>
  .section {
    padding-top: 64px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  h2 {
    margin-top: -12px;
    font-size: clamp(24px, 4.5vw, 32px);
    line-height: 1.15;
    font-weight: 800;
    text-align: center;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 20px;
  }
  .card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .quote {
    font-size: 36px;
    line-height: 1;
    color: var(--orange-dark);
    font-weight: 800;
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    font-size: 15px;
    line-height: 1.6;
  }
  strong {
    font-size: 14px;
  }
  @media (min-width: 768px) {
    .section {
      padding-top: 88px;
      padding-bottom: 88px;
      gap: 36px;
    }
  }
</style>
