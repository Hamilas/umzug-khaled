---
// Kundenstimmen: Karten mit Bewertungstext, Leistung und gekürztem Namen (Vorname + Initial).
import { site } from '../data/site';

// Echte Kundenbewertungen, laut Inhaber per ChatGPT aus Fotos alter Bewertungen abgetippt.
// Wortlaut mit den Originalfotos abgleichen. Nur Bewertungen mit Einverständnis der Kunden verwenden.
const reviews = [
  {
    service: 'Umzugsservice',
    text: 'Super Service! Der Umzug lief schnell und unkompliziert. Die Mitarbeiter waren pünktlich, freundlich und haben sehr sorgfältig gearbeitet. Vielen Dank!',
    author: 'Michael S.',
  },
  {
    service: 'Entrümpelung',
    text: 'Sehr zuverlässig und professionell. Unsere Wohnung wurde komplett entrümpelt und alles sauber hinterlassen. Preis-Leistung stimmt auch. Klare Empfehlung!',
    author: 'Sarah H.',
  },
  {
    service: 'Möbeltransport',
    text: 'Habe kurzfristig Hilfe beim Möbeltransport gebraucht. Alles hat super geklappt, die Kommunikation war einfach und die Möbel kamen unbeschädigt an. Gerne wieder!',
    author: 'Daniel W.',
  },
  {
    service: 'Haushaltsauflösung',
    text: 'Wir waren sehr zufrieden. Die Haushaltsauflösung wurde schnell und ordentlich erledigt. Das Team war hilfsbereit und hat uns viel Stress erspart.',
    author: 'Claudia B.',
  },
  {
    service: null,
    text: 'Top Service, faire Preise und sehr nette Mitarbeiter. Alles lief wie vereinbart. Kann ich nur weiterempfehlen!',
    author: 'Thomas M.',
  },
  {
    service: 'Möbelmontage',
    text: 'Sehr freundliches Team! Die Möbel wurden vorsichtig transportiert und anschließend ordentlich aufgebaut. Alles lief reibungslos.',
    author: 'Julia F.',
  },
];
---

<section class="container section" aria-labelledby="stimmen-titel">
  <span class="eyebrow">Kundenstimmen</span>
  <h2 id="stimmen-titel">Was unsere Kunden sagen.</h2>
  <ul class="grid">
    {
      reviews.map((r) => (
        <li class="card">
          <span class="quote" aria-hidden="true">“</span>
          <blockquote>
            <p>{r.text}</p>
          </blockquote>
          {/* Name unten, Leistung (falls angegeben) daneben */}
          <footer class="meta">
            <strong>{r.author}</strong>
            {r.service && <span class="service">{r.service}</span>}
          </footer>
        </li>
      ))
    }
  </ul>
  {/* Google-Button erscheint automatisch, sobald googleReviewsUrl in site.ts gesetzt ist */}
  {
    site.googleReviewsUrl ? (
      <a href={site.googleReviewsUrl} class="btn btn-outline" target="_blank" rel="noopener">
        Bewertungen auf Google ansehen
      </a>
    ) : (
      <p class="placeholder">[PLATZHALTER: Link „Bewertungen auf Google ansehen“]</p>
    )
  }
</section>

<style>
  .section {
    padding-top: 64px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  h2 {
    margin-top: -12px;
    font-size: clamp(24px, 4.5vw, 32px);
    line-height: 1.15;
    font-weight: 800;
    text-align: center;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 20px;
  }
  .card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .quote {
    font-size: 36px;
    line-height: 1;
    color: var(--orange-dark);
    font-weight: 800;
  }
  blockquote {
    margin: 0;
  }
  blockquote {
    flex: 1;
  }
  blockquote p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }
  strong {
    font-size: 14px;
  }
  .service {
    font-size: 12px;
    font-weight: 700;
    color: var(--navy);
    background: var(--bg-soft);
    padding: 4px 10px;
    border-radius: 999px;
  }
  /* Ab 768 px (Tablet/Desktop): größere Abstände */
  @media (min-width: 768px) {
    .section {
      padding-top: 88px;
      padding-bottom: 88px;
      gap: 36px;
    }
  }
</style>
